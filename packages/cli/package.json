{
  "name": "poplin",
  "version": "0.1.2",
  "description": "Agents publish static sites to your own Cloudflare account: private by default, shareable by secret link, or public.",
  "keywords": [
    "static-site",
    "static-hosting",
    "publish",
    "cloudflare",
    "cloudflare-workers",
    "mcp",
    "mcp-server",
    "ai-agents",
    "cli"
  ],
  "homepage": "https://vivswan.github.io/poplin/",
  "bugs": {
    "url": "https://github.com/Vivswan/poplin/issues"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vivswan/poplin.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "poplin": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/poplin.d.mts",
      "default": "./dist/poplin.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "default": "./dist/core.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "smoke": "bun scripts/smoke.ts"
  },
  "devDependencies": {
    "@clack/prompts": "1.9.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/damerau-levenshtein": "1.0.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@valibot/to-json-schema": "1.8.0",
    "clipboardy": "5.3.2",
    "commander": "15.1.0",
    "consola": "3.4.2",
    "damerau-levenshtein": "1.0.8",
    "hono": "4.13.18",
    "htmlparser2": "12.0.0",
    "mime": "4.1.2",
    "open": "11.0.4",
    "p-map": "7.1.1",
    "p-retry": "9.0.0",
    "publint": "0.3.25",
    "srcset": "5.0.3",
    "string-width": "9.0.0",
    "terminal-link": "5.0.0",
    "tsdown": "0.23.7",
    "valibot": "1.5.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
