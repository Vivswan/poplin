{
  "name": "@poplin/cloudflare",
  "private": true,
  "type": "module",
  "exports": {
    "./src/worker/bindings": "./src/worker/bindings.ts",
    "./src/database/d1": "./src/database/d1.ts",
    "./src/storage/r2": "./src/storage/r2.ts",
    "./src/zone/zone-binding": "./src/zone/zone-binding.ts"
  },
  "scripts": {
    "typecheck": "wrangler types ./worker-configuration.d.ts --config ../../wrangler.jsonc && tsc -p .",
    "build": "wrangler deploy --dry-run --outdir packages/cloudflare/dist --config ../../wrangler.jsonc",
    "deploy": "bun scripts/deploy.ts",
    "test": "bun run build && vitest run",
    "live:converge": "bun scripts/live/converge.ts",
    "live:suite": "bun scripts/live/suite.ts",
    "live:reset": "bun scripts/live/reset.ts"
  },
  "dependencies": {
    "@poplin/app": "workspace:*",
    "@poplin/core": "workspace:*",
    "cloudflare": "7.3.0",
    "jose": "6.2.17",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@cloudflare/vitest-plugin": "1.8.2",
    "hono": "4.13.18",
    "uint8array-extras": "1.6.0",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
