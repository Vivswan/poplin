{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poplin",
  "main": "src/worker/worker.ts",
  "compatibility_date": "2026-11-01",
  // The sweep: expired sites to the trash, old trash and abandoned uploads away.
  "triggers": { "crons": ["*/15 * * * *"] },
  "r2_buckets": [{ "binding": "SITES", "bucket_name": "example-sites-bucket" }],
  "d1_databases": [{ "binding": "DB", "database_name": "example-poplin-database", "database_id": "00000000-0000-0000-0000-000000000000" }],
  // The limit is a fixed ceiling: each request weighs the ceiling divided by the per-minute setting in force, so a setting changes with no deploy.
  "ratelimits": [{ "name": "MINUTE_LIMITS", "namespace_id": "1001", "simple": { "limit": 1000000, "period": 60 } }],
  "vars": {
    "ZONE": { "domain": "example.com" },
    "ACCESS": { "team_domain": "team.cloudflareaccess.com", "audience": "4714c1358e65fe4b408ad6d432a5f878f08194bdb4752441fd56faefa9b2b6f2" },
    "FIRST_SETTINGS": {
      "default_expires": "never",
      "default_search_engines": "off",
      "versions_kept": "3",
      "trash_days": "7",
      "logins": "owner@example.com",
      "dashboard_title": "poplin.example.com",
      "gallery": "off",
      "private_sites": "single-file",
      "outside_pages": "blocked",
      "search_engines_allowed": "off",
      "block_bots": "auto",
      "max_total_size": "9GB",
      "max_site_size": "200MB",
      "max_sites": "none",
      "requests_per_day": "100000",
      "site_share_of_day": "25%",
      "site_requests_per_minute": "60",
      "visitor_requests_per_minute": "30"
    }
  }
}
