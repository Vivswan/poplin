{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // The first is what `wrangler types` writes from wrangler.jsonc: the runtime's types and the `Env` of its bindings.
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],
    // Core's contract suite imports its test functions from bun; here they are Vitest's, as vitest.config.ts resolves them.
    "paths": { "bun:test": ["./node_modules/vitest"] }
  },
  "include": ["src/worker", "src/storage", "src/database", "src/limits", "tests/worker", "tests/storage", "tests/database", "tests/limits", "vitest.config.ts"],
  "exclude": []
}
