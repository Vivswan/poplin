// The repository's own biome layer: exclusions, the formatter, extra rules, and per-path overrides with their
// reasons. The managed biome.json extends this file and applies last, so the floor cannot be lowered here; the one
// relaxation is a per-path `overrides` entry below with its reason beside it (docs/modules/typescript.md).
{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  // noCommonJs and noUnusedTemplateLiteral: the patterns of noRestrictedImports read no `require` call and no path written as a template, so the tree holds neither.
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noUnusedTemplateLiteral": "error",
        "noNonNullAssertion": "error"
      }
    }
  },
  // Reads an .astro file whole, so a name its template uses counts as used.
  "html": { "experimentalFullSupportEnabled": true },
  // Reads the stylesheets of the dashboard and of the website's controls, which are written in the directives of their CSS framework.
  "css": { "parser": { "tailwindDirectives": true } },
  // A later entry replaces an earlier entry's options for the same rule, so a narrower place repeats what it keeps.
  "overrides": [
    // Source outside a migrations folder imports none: a step outlives its release only where code reaches for it. tests/no-old-shapes.test.ts plants each leak.
    // The path names no package, so it holds under a package's own settings file too, which counts an entry's paths from its own folder.
    {
      "includes": ["**/src/**", "!**/migrations/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  { "group": ["**/migrations", "**/migrations/**"], "message": "Only a migrations folder and the doorway that runs its steps import one." }
                ]
              }
            }
          }
        }
      }
    },
    // The portable packages hold no provider: its modules, types, and globals stay in packages/cloudflare. tests/portable.test.ts plants each leak.
    {
      "includes": ["packages/core/**", "packages/app/**", "packages/cli/**", "packages/demo/**", "packages/dashboard/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:module": { "importNames": ["createRequire"], "message": "Portable code loads a module by an import, which the rules here read." },
                  "module": { "importNames": ["createRequire"], "message": "Portable code loads a module by an import, which the rules here read." }
                },
                "patterns": [
                  {
                    "group": [
                      "cloudflare",
                      "cloudflare:*",
                      "@cloudflare/**",
                      "wrangler",
                      "wrangler/**",
                      "miniflare",
                      "miniflare/**",
                      "@poplin/cloudflare",
                      "**/cloudflare/**"
                    ],
                    "message": "Portable code has no provider module: packages/cloudflare owns it."
                  }
                ]
              }
            },
            "noRestrictedTypes": {
              "level": "error",
              "options": {
                "types": {
                  "Bindings": "Portable code has no provider type: packages/cloudflare owns it.",
                  "CloudflareBindings": "Portable code has no provider type: packages/cloudflare owns it.",
                  "Env": "Portable code has no provider type: packages/cloudflare owns it.",
                  "ExecutionContext": "Portable code has no provider type: packages/cloudflare owns it.",
                  "ExportedHandler": "Portable code has no provider type: packages/cloudflare owns it."
                }
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "FixedLengthStream": "Portable code names no provider global: packages/cloudflare owns it.",
                  "HTMLRewriter": "Portable code names no provider global: packages/cloudflare owns it.",
                  "WebSocketPair": "Portable code names no provider global: packages/cloudflare owns it."
                }
              }
            }
          }
        }
      }
    },
    // The source of the app and of the CLI is under the portable rule and the one on migrations folders.
    {
      "includes": ["packages/app/src/**", "packages/cli/src/**", "!**/migrations/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:module": { "importNames": ["createRequire"], "message": "Portable code loads a module by an import, which the rules here read." },
                  "module": { "importNames": ["createRequire"], "message": "Portable code loads a module by an import, which the rules here read." }
                },
                "patterns": [
                  {
                    "group": [
                      "cloudflare",
                      "cloudflare:*",
                      "@cloudflare/**",
                      "wrangler",
                      "wrangler/**",
                      "miniflare",
                      "miniflare/**",
                      "@poplin/cloudflare",
                      "**/cloudflare/**"
                    ],
                    "message": "Portable code has no provider module: packages/cloudflare owns it."
                  },
                  { "group": ["**/migrations", "**/migrations/**"], "message": "Only a migrations folder and the doorway that runs its steps import one." }
                ]
              }
            }
          }
        }
      }
    },
    // Core is the logic every surface shares, so it imports no HTTP framework, provider, or runtime module.
    {
      "includes": ["packages/core/src/**"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "error" },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "cloudflare",
                      "cloudflare:*",
                      "@cloudflare/**",
                      "wrangler",
                      "wrangler/**",
                      "miniflare",
                      "miniflare/**",
                      "@poplin/cloudflare",
                      "**/cloudflare/**"
                    ],
                    "message": "Portable code has no provider module: packages/cloudflare owns it."
                  },
                  { "group": ["hono", "hono/**"], "message": "Core has no HTTP framework: the app package owns it." },
                  { "group": ["bun", "bun:*"], "message": "Core has no runtime module: it runs in a Worker." },
                  { "group": ["**/migrations", "**/migrations/**"], "message": "Only a migrations folder and the doorway that runs its steps import one." }
                ]
              }
            }
          }
        }
      }
    },
    // Core's migrations folders, and the one doorway that runs their steps, are under core's rules less the one on migrations.
    {
      "includes": ["packages/core/src/**/migrations/**", "packages/core/src/database/open.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "cloudflare",
                      "cloudflare:*",
                      "@cloudflare/**",
                      "wrangler",
                      "wrangler/**",
                      "miniflare",
                      "miniflare/**",
                      "@poplin/cloudflare",
                      "**/cloudflare/**"
                    ],
                    "message": "Portable code has no provider module: packages/cloudflare owns it."
                  },
                  { "group": ["hono", "hono/**"], "message": "Core has no HTTP framework: the app package owns it." },
                  { "group": ["bun", "bun:*"], "message": "Core has no runtime module: it runs in a Worker." }
                ]
              }
            }
          }
        }
      }
    },
    // The dashboard runs in a browser, so it imports no provider or runtime module and names no runtime global.
    {
      "includes": ["packages/dashboard/src/**"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "error" },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "cloudflare",
                      "cloudflare:*",
                      "@cloudflare/**",
                      "wrangler",
                      "wrangler/**",
                      "miniflare",
                      "miniflare/**",
                      "@poplin/cloudflare",
                      "**/cloudflare/**"
                    ],
                    "message": "Portable code has no provider module: packages/cloudflare owns it."
                  },
                  { "group": ["bun", "bun:*"], "message": "The dashboard has no runtime module: it runs in a browser." },
                  { "group": ["**/migrations", "**/migrations/**"], "message": "Only a migrations folder and the doorway that runs its steps import one." }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Buffer": "The dashboard names no runtime global: it runs in a browser.",
                  "Bun": "The dashboard names no runtime global: it runs in a browser.",
                  "FixedLengthStream": "Portable code names no provider global: packages/cloudflare owns it.",
                  "HTMLRewriter": "Portable code names no provider global: packages/cloudflare owns it.",
                  "WebSocketPair": "Portable code names no provider global: packages/cloudflare owns it.",
                  "process": "The dashboard names no runtime global: it runs in a browser."
                }
              }
            }
          }
        }
      }
    },
    // The demo runs in a browser too, so its source imports only its own files, the portable source of the app and of core, and the libraries a browser runs, SQLite built for one among them.
    {
      "includes": ["packages/demo/src/**"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "error" },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!./**",
                      "!../preview/**",
                      "!../browser/**",
                      "!../../../app/src/**",
                      "!../../../core/src/**",
                      "!sql.js",
                      "!sql.js/dist/sql-wasm-browser.js",
                      "!idb-keyval",
                      "!cookie",
                      "!hono/html",
                      "!htmlparser2",
                      "**/migrations",
                      "**/migrations/**"
                    ],
                    "message": "The demo imports its own files, the source of the app and of core but for a migrations folder, and the libraries a browser runs."
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Buffer": "The demo names no runtime global: it runs in a browser.",
                  "Bun": "The demo names no runtime global: it runs in a browser.",
                  "FixedLengthStream": "Portable code names no provider global: packages/cloudflare owns it.",
                  "HTMLRewriter": "Portable code names no provider global: packages/cloudflare owns it.",
                  "WebSocketPair": "Portable code names no provider global: packages/cloudflare owns it.",
                  "process": "The demo names no runtime global: it runs in a browser."
                }
              }
            }
          }
        }
      }
    },
    // A published package's entry is the one file that re-exports: core is private, so its modules reach npm through it.
    {
      "includes": ["packages/cli/src/core.ts"],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    },
    // A describe callback is a list of cases, not one function: its length is the number of cases, and splitting
    // it would scatter one module's cases across helpers.
    {
      "includes": ["**/tests/**/*.ts", "**/tests/**/*.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": "off" } } }
    },
    // The components the UI library's own tooling writes stay as it wrote them, so a newer one replaces a file
    // cleanly: they are neither linted nor formatted here.
    {
      "includes": ["packages/dashboard/src/components/**"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    }
  ]
}
