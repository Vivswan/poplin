{
  "$schema": "packages/providers/cloudflare/node_modules/wrangler/config-schema.json",
  "name": "poplin",
  "main": "packages/providers/cloudflare/src/shared/worker/worker.ts",
  "compatibility_date": "2026-11-01",
  // The Worker's own code and its libraries are bundled minified. Functions and classes keep their names.
  "minify": true,
  // Every upload carries the bundle's source map, so an error in Cloudflare's log names a source file and its line. An upload whose map is missing stops.
  "upload_source_maps": true,
  // Cloudflare keeps the lines the Worker writes and its errors, of every request. The record Cloudflare would make of each request by itself is off: it holds the request's address, and the address of an unlisted or a private site is its link.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "invocation_logs": false } },
  // Before the Worker is bundled: the dashboard's client is built and written into the Worker's sources as one module, which no commit holds.
  "build": { "command": "bun run --filter @poplin/cloudflare built-client" },
  // The install's own values are written onto the Worker itself, by setup. A deploy leaves them as they are.
  // The Worker reads one secret, KEPT_KEY. A secret is never named here, and a deploy leaves it as it is.
  "keep_vars": true,
  // The sweep: expired sites to the trash, old trash and abandoned uploads away.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Neither has an id: a deploy creates the bucket and the database the first time.
  "r2_buckets": [{ "binding": "SITES", "bucket_name": "poplin-sites" }],
  "d1_databases": [{ "binding": "DB", "database_name": "poplin" }],
  // The limit is a fixed ceiling: each request weighs the ceiling divided by the per-minute setting in force, so a setting changes with no deploy.
  "ratelimits": [{ "name": "MINUTE_LIMITS", "namespace_id": "1001", "simple": { "limit": 1000000, "period": 60 } }],
  // The background work: the rounds of a copy too large for one request, one a step. Its name holds the Worker's, since an account names each Workflow once.
  "workflows": [{ "name": "poplin-jobs", "binding": "JOBS", "class_name": "PoplinJobs" }],
  // The Worker's own name, which its routes name. It is the `name` above.
  "vars": { "WORKER_NAME": "poplin" }
}
