#!/bin/sh
# Check-only: lints the staged files, typechecks, and runs the tests the staged files reach. It never stages, commits,
# installs, or reaches the network; a missing node_modules fails the first check on its own.
#
#   staged path                -> tests run
#   packages/core/...          -> every test, the Worker's included: the other packages depend on core
#   packages/app/...           -> its tests, the Worker's tests, the fuzz tests, and the layout guard
#   packages/cli/...           -> its tests, the fuzz tests, and the layout guard
#   packages/worker/...        -> the Worker's tests, in the Workers runtime, and the layout guard
#   anything else              -> every test
set -e

bun node_modules/.bin/biome lint --staged --no-errors-on-unmatched
bun run typecheck

# A rename counts as both of its paths, so a file moved out of a package still runs that package's tests.
staged=$(git diff --cached --name-only --no-renames)
reaches_all=$(printf '%s\n' "$staged" | sed -n -e '\|^packages/[^/]*/|!p' -e '\|^packages/core/|p')
packages=$(printf '%s\n' "$staged" | sed -n 's|^\(packages/[^/]*\)/.*|./\1/|p' | sort -u)

# The Worker's tests import the app package, and the fuzz tests import the app and the command line.
reaches_worker=$(printf '%s\n' "$staged" | sed -n -e '\|^packages/worker/|p' -e '\|^packages/app/|p')
reaches_fuzz=$(printf '%s\n' "$staged" | sed -n -e '\|^packages/app/|p' -e '\|^packages/cli/|p')

# The Worker's tests run under Vitest; the root test script leaves that package out.
if [ -n "$reaches_all$reaches_worker" ]; then
    bun run test:worker
fi

if [ -n "$reaches_all" ]; then
    exec bun run test
fi

if [ -n "$reaches_fuzz" ]; then
    packages="$packages
./tests/fuzz/"
fi

# One argument per line of $packages: split on newlines alone, with no globbing.
IFS='
'
set -f
# shellcheck disable=SC2086
bun run test $packages ./tests/layout.test.ts
