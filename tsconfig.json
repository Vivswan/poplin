{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  // package.json is the one input that always exists: tsc fails with TS18003 when include matches no file.
  "files": ["package.json"],
  "include": ["packages", "tests"]
}
