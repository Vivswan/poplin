{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"]
  },
  "include": ["packages", "tests"],
  "exclude": [
    "packages/providers/cloudflare/worker-configuration.d.ts",
    "packages/providers/cloudflare/vitest.config.ts",
    "packages/providers/cloudflare/src/shared/worker",
    "packages/providers/cloudflare/src/shared/storage",
    "packages/providers/cloudflare/src/shared/database",
    "packages/providers/cloudflare/src/shared/limits",
    "packages/providers/cloudflare/src/shared/jobs/workflow.ts",
    "packages/providers/cloudflare/src/shared/jobs/workflow-jobs.ts",
    "packages/providers/cloudflare/tests/shared/worker",
    "packages/providers/cloudflare/tests/shared/storage",
    "packages/providers/cloudflare/tests/shared/database",
    "packages/providers/cloudflare/tests/shared/limits",
    "packages/providers/cloudflare/tests/shared/jobs",
    "packages/providers/cloudflare/load",
    "packages/providers/cloudflare/tests/load",
    "packages/demo/src/browser/worker.ts",
    "packages/dashboard"
  ]
}
