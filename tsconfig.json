{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"]
  },
  "include": ["packages", "tests"],
  "exclude": [
    "packages/providers/cloudflare/worker-configuration.d.ts",
    "packages/providers/cloudflare/vitest.config.ts",
    "packages/providers/cloudflare/src/worker",
    "packages/providers/cloudflare/src/storage",
    "packages/providers/cloudflare/src/database",
    "packages/providers/cloudflare/src/limits",
    "packages/providers/cloudflare/src/jobs/workflow.ts",
    "packages/providers/cloudflare/src/jobs/workflow-jobs.ts",
    "packages/providers/cloudflare/tests/worker",
    "packages/providers/cloudflare/tests/storage",
    "packages/providers/cloudflare/tests/database",
    "packages/providers/cloudflare/tests/limits",
    "packages/providers/cloudflare/tests/jobs",
    "packages/demo/src/browser/worker.ts",
    "packages/dashboard"
  ]
}
