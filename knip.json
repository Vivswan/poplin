{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["demo/**"],
  "ignoreBinaries": ["lychee"],
  "workspaces": {
    "packages/cli": {
      "ignoreBinaries": ["mkfifo"]
    },
    "packages/core": {
      "includeEntryExports": true,
      "ignoreIssues": { "src/actions.ts": ["exports"] }
    },
    "packages/demo": {
      "entry": ["src/browser/worker.ts"]
    },
    "packages/providers/cloudflare": {
      "entry": ["src/shared/worker/worker.ts", "src/shared/install/first/installer.ts", "tests/**/*.test.ts", "live/live.test.ts"]
    },
    "packages/dashboard": {
      "entry": ["src/main.tsx", "tests/**/*.test.{ts,tsx}"],
      "ignore": ["src/components/ui/**"],
      "ignoreDependencies": ["@fontsource/noto-sans"]
    }
  }
}
