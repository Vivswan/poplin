---
import { CompareTable } from "../controls/compare-table.tsx";
import { REPOSITORY_URL } from "../lib/paths.ts";

// Poplin beside the tools people reach for to put a page online. The answers live in one table of data; the table of the UI library draws it, and this gives it its look.
const ISSUES = `${REPOSITORY_URL}/issues`;
---

<div class="compare">
  <CompareTable issues={ISSUES} />
</div>
<div class="legend">
  <p>A dash: their own pages do not say.</p>
  <p>Missing something? <a href={`${ISSUES}?q=is%3Aissue+is%3Aopen+label%3Aparked`}>See the open requests and vote.</a></p>
</div>

<style>
  .compare :global([data-slot="table-container"]) {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .legend {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .legend p + p {
    margin-top: 4px;
  }

  .compare :global(table) {
    min-width: 760px;
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .compare :global(th),
  .compare :global(td) {
    padding: 11px 14px;
    text-align: center;
    font-weight: 400;
    white-space: nowrap;
  }

  .compare :global(thead th) {
    padding-block: 14px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .compare :global(tbody th),
  .compare :global(thead td) {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--surface);
    text-align: left;
  }

  .compare :global(tbody tr) {
    border-top: 1px solid var(--rule);
  }

  .compare :global(tbody td) {
    color: var(--fg);
    font-size: 0.875rem;
    vertical-align: middle;
  }

  .compare :global(.ours),
  .compare :global(tbody td.ours) {
    background: var(--accent-tint);
    color: var(--fg);
    font-weight: 600;
  }

  .compare :global(thead .ours) {
    color: var(--accent-text);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .compare :global(svg) {
    margin-inline: auto;
  }

  .compare :global(.no svg),
  .compare :global(.unsaid) {
    color: var(--muted);
  }

  .compare :global(.ours svg) {
    color: var(--accent-text);
  }

  /* A request is a number in our column's ink, underlined when pointed at. */
  .compare :global(.ours a) {
    color: var(--accent-text);
    text-decoration: none;
  }

  .compare :global(.ours a:hover) {
    text-decoration: underline;
  }

  /* Between a phone and a desk the whole table fits its column with tighter cells; only a phone scrolls sideways. */
  @media (max-width: 960px) {
    .compare :global(table) {
      min-width: 0;
    }

    .compare :global(th),
    .compare :global(td) {
      padding-inline: 9px;
    }
  }

  @media (max-width: 720px) {
    .compare :global([data-slot="table-container"]) {
      margin-right: calc(-1 * var(--edge));
      border-right: 0;
      border-radius: var(--radius) 0 0 var(--radius);
    }

    .compare :global(table) {
      min-width: 640px;
    }

    .compare :global(th),
    .compare :global(td) {
      padding: 11px 10px;
    }

    .compare :global(tbody th) {
      white-space: normal;
      width: 10.5rem;
    }
  }
</style>
