---
import ArrowUp from "@lucide/astro/icons/arrow-up";
import Check from "@lucide/astro/icons/check";
import Folder from "@lucide/astro/icons/folder";
import LoaderCircle from "@lucide/astro/icons/loader-circle";
import Sparkle from "@lucide/astro/icons/sparkle";
import Terminal from "@lucide/astro/icons/terminal";
import Wrench from "@lucide/astro/icons/wrench";
import { EXAMPLE_HOST, EXAMPLE_SITE } from "../lib/example.ts";

// The request, two ways: a person asks an agent, or types the command. Both answer with the same address.
const SITE = EXAMPLE_SITE;
const HOST = EXAMPLE_HOST;
---

<div class="swap ask">
  <div class="window" data-door="agent">
    <p class="head">
      <Sparkle />
      Agent
    </p>
    <div class="talk">
      <p class="you part">
        <span class="file">
          <Folder />
          report
        </span>
        Publish this report
      </p>
      <p class="tool part">
        <Wrench />
        <span>poplin</span>
        <code>publish_site ./report</code>
        <span class="swap state" aria-hidden="true">
          <LoaderCircle class="spin" />
          <Check class="done" />
        </span>
      </p>
      <p class="reply part">
        It is online, and private.
        <code>{HOST}</code>
      </p>
    </div>
    <p class="compose" aria-hidden="true">
      Ask anything
      <ArrowUp />
    </p>
  </div>

  <div class="window" data-door="terminal">
    <p class="head">
      <Terminal />
      Terminal
    </p>
    <code class="term">
      <span><i>$</i> poplin ./report</span>
      <span class="dim">made <b>{SITE}</b> <em>private</em></span>
      <span>https://{HOST}</span>
      <span class="next"><i>$</i> poplin ./report --site {SITE}</span>
      <span class="dim">updated <b>{SITE}</b> <em>version 2</em></span>
    </code>
  </div>
</div>

<style>
  .ask {
    font: 400 0.875rem / 1.5 var(--sans);
  }

  [data-door] {
    opacity: 0;
    visibility: hidden;
  }

  :global(.path[data-door="agent"]) [data-door="agent"],
  :global(.path[data-door="terminal"]) [data-door="terminal"] {
    opacity: 1;
    visibility: visible;
  }

  /* Both doors are one window of one size: a title, a body, and for the agent a place to type. */
  .window {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
    font-weight: 600;
    font-size: 0.8125rem;
  }

  .talk {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 16px 14px;
  }

  .you {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 7px;
    border-radius: 16px 16px 4px 16px;
    background: var(--fill);
  }

  .file {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px 3px 7px;
    border-radius: 9px;
    background: var(--surface);
    font-weight: 600;
    font-size: 0.8125rem;
  }

  /* The tool at work: the moment the agent does something. */
  .tool {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    padding: 6px 10px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .tool span:not(.state) {
    color: var(--fg);
    font-weight: 600;
  }

  .tool code {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .state {
    flex: none;
    width: 16px;
    height: 16px;
    margin-left: 4px;
  }

  .spin {
    opacity: 0;
  }

  .done {
    color: var(--ok);
  }

  .reply code {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-top: 2px;
    color: var(--accent-text);
    font-size: clamp(0.625rem, 2.75vw, 0.8125rem);
    letter-spacing: 0.02em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }

  .compose {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 10px 10px;
    padding: 8px 8px 8px 14px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .compose svg {
    width: 24px;
    height: 24px;
    padding: 5px;
    border-radius: 50%;
    background: var(--fill);
    color: var(--muted);
  }

  .term {
    flex: 1;
    display: grid;
    align-content: center;
    gap: 2px;
    padding: 16px 14px;
    font: 400 clamp(0.75rem, 3.1vw, 0.8125rem) / 1.7 var(--mono);
    overflow-wrap: anywhere;
  }

  .term span {
    display: block;
  }

  .term .next {
    margin-top: 0.9em;
  }

  .term i {
    color: var(--muted);
    font-style: normal;
  }

  .term .dim {
    color: var(--muted);
  }

  .term b {
    color: var(--fg);
    font-weight: 400;
  }

  .term em {
    color: var(--ok);
    font-style: normal;
  }

  /* The request plays once, by the page's script: the ask, the tool at work, the answer. Until it does they wait unseen. */
  :global(.moves) .part,
  :global(.moves) .done {
    opacity: 0;
  }
</style>
