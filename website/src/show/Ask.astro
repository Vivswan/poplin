---
import { EXAMPLE_HOST, EXAMPLE_SITE } from "../lib/example.ts";

// The request, two ways: a person asks an agent, or types the command. Both answer with the same address.
const SITE = EXAMPLE_SITE;
const HOST = EXAMPLE_HOST;
---

<div class="swap ask">
  <div class="window" data-door="agent">
    <p class="head">
      <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 2.5l1.5 4 4 1.5-4 1.5-1.5 4-1.5-4-4-1.5 4-1.5z"></path></svg>
      Agent
    </p>
    <div class="talk">
      <p class="you part" style="--d:0ms">
        <span class="file">
          <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M2 4.5a1 1 0 0 1 1-1h3l1.5 1.5H13a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"></path></svg>
          report
        </span>
        Publish this report
      </p>
      <p class="tool part" style="--d:400ms">
        <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M10 2.5a3.5 3.5 0 0 0-3.3 4.7L2.5 11.4v2.1h2.1l4.2-4.2A3.5 3.5 0 0 0 13.5 6l-2.2 2.2-1.5-1.5L12 4.500A3.500 3.500 0 0 0 10 2.500z"></path></svg>
        <span>poplin</span>
        <code>publish_site ./report</code>
        <span class="swap state" aria-hidden="true">
          <svg aria-hidden="true" class="spin" viewBox="0 0 16 16"><path d="M8 2.5a5.5 5.5 0 1 1-5.5 5.5"></path></svg>
          <svg aria-hidden="true" class="done" viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7"></path></svg>
        </span>
      </p>
      <p class="reply part" style="--d:1300ms">
        It is online, and private.
        <code>{HOST}</code>
      </p>
    </div>
    <p class="compose" aria-hidden="true">
      Ask anything
      <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 12.5v-9M4.5 7L8 3.5 11.5 7"></path></svg>
    </p>
  </div>

  <div class="window" data-door="terminal">
    <p class="head">
      <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M3.5 5l3 3-3 3M8.500 11.500h4"></path></svg>
      Terminal
    </p>
    <code class="term">
      <span><i>$</i> poplin ./report</span>
      <span class="dim">made <b>{SITE}</b> <em>private</em></span>
      <span>https://{HOST}</span>
      <span class="next"><i>$</i> poplin ./report --site {SITE}</span>
      <span class="dim">updated <b>{SITE}</b> <em>version 2</em></span>
    </code>
  </div>
</div>

<style>
  .ask {
    font: 400 0.875rem / 1.5 var(--sans);
  }

  svg {
    flex: none;
    display: block;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  [data-door] {
    opacity: 0;
    visibility: hidden;
  }

  :global(.path:has(input[value="agent"]:checked)) [data-door="agent"],
  :global(.path:has(input[value="terminal"]:checked)) [data-door="terminal"] {
    opacity: 1;
    visibility: visible;
  }

  @supports not selector(:has(*)) {
    [data-door="agent"] {
      opacity: 1;
      visibility: visible;
    }
  }

  /* Both doors are one window of one size: a title, a body, and for the agent a place to type. */
  .window {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
    font-weight: 600;
    font-size: 0.8125rem;
  }

  .talk {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 16px 14px;
  }

  .you {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 7px;
    border-radius: 16px 16px 4px 16px;
    background: var(--fill);
  }

  .file {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px 3px 7px;
    border-radius: 9px;
    background: var(--surface);
    font-weight: 600;
    font-size: 0.8125rem;
  }

  /* The tool at work: the moment the agent does something. */
  .tool {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    padding: 6px 10px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .tool span:not(.state) {
    color: var(--fg);
    font-weight: 600;
  }

  .tool code {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .state {
    flex: none;
    width: 16px;
    height: 16px;
    margin-left: 4px;
  }

  .spin {
    opacity: 0;
  }

  .done {
    color: var(--ok);
    stroke-width: 2;
  }

  .reply code {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-top: 2px;
    color: var(--accent-text);
    font-size: clamp(0.625rem, 2.75vw, 0.8125rem);
    letter-spacing: 0.02em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }

  .compose {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 10px 10px;
    padding: 8px 8px 8px 14px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .compose svg {
    width: 24px;
    height: 24px;
    padding: 4px;
    border-radius: 50%;
    background: var(--fill);
    color: var(--muted);
  }

  .term {
    flex: 1;
    display: grid;
    align-content: center;
    gap: 2px;
    padding: 16px 14px;
    font: 400 clamp(0.75rem, 3.1vw, 0.8125rem) / 1.7 var(--mono);
    overflow-wrap: anywhere;
  }

  .term span {
    display: block;
  }

  .term .next {
    margin-top: 0.9em;
  }

  .term i {
    color: var(--muted);
    font-style: normal;
  }

  .term .dim {
    color: var(--muted);
  }

  .term b {
    color: var(--fg);
    font-weight: 400;
  }

  .term em {
    color: var(--ok);
    font-style: normal;
  }

  /* The request plays once: the ask, the tool at work, the answer. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.path.play) .part {
      animation: arrive 350ms var(--ease) var(--d) both;
    }

    :global(.path.play) .spin {
      animation: work 700ms linear 400ms both;
    }

    :global(.path.play) .done {
      animation: arrive 200ms var(--ease) 1100ms both;
    }

    :global(.js .path:not(.play)) .part,
    :global(.js .path:not(.play)) .done {
      opacity: 0;
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @keyframes work {
    from {
      opacity: 1;
      transform: rotate(0);
    }

    85% {
      opacity: 1;
    }

    to {
      opacity: 0;
      transform: rotate(540deg);
    }
  }
</style>
