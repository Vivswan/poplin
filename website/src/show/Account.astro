---
import { PROVIDERS } from "../lib/providers.ts";

// What a visitor's request passes before it reaches a site, and where the site lives: all inside your own account.
// A guard marked optional is there only when the install was given the rights to add it, so it is drawn dashed.
const guards = [
  { name: "Firewall", note: "own hostnames", optional: true },
  { name: "Bot block", note: "crawlers", optional: true },
  { name: "Rate limit", note: "per address", optional: true },
  { name: "Login", note: "private only", optional: false },
];
const stores = [
  { name: "Bucket", note: "files" },
  { name: "Database", note: "records" },
];
const told = [
  "A visitor's request passes three optional guards: a firewall that lets through only this install's hostnames, a block on crawlers, and a rate limit per address.",
  "For private sites only, it then passes a login.",
  "Then one Worker serves the site from a bucket of files and a database of records.",
  `All of it is inside your own ${PROVIDERS[0]} account.`,
].join(" ");
---

<figure
  class="account"
  aria-label={told}
>
  <div class="node out" data-from>Visitor</div>
  <div class="wire out" aria-hidden="true"></div>
  <div class="inside">
    <p>
      Your {PROVIDERS[0]} account
      <span class="key"><i></i>optional</span>
    </p>
    <div class="wire lead" aria-hidden="true"></div>
    {
      guards.map((guard) => (
        <>
          <div class:list={["node", guard.optional && "optional"]}>
            {guard.name}
            <small>{guard.note}</small>
          </div>
          <div class="wire" aria-hidden="true" />
        </>
      ))
    }
    <div class="node worker">
      Worker
      <small>every site</small>
    </div>
    <div class="stores">
      <div class="fork" aria-hidden="true">
        <i class="dot split"></i>
        <i class="dot split"></i>
      </div>
      <div class="pair">
        {
          stores.map((store) => (
            <div class="node" data-store>
              {store.name}
              <small>{store.note}</small>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <i class="dot flow" aria-hidden="true"></i>
</figure>

<script>
  import { type AnimationPlaybackControls, type AnimationSequence, animate, inView, resize } from "motion";
  import { EASE } from "../lib/ease.ts";

  // One timeline drives the whole figure, round after round. Leaving the screen or the tab ends the round.
  // The dot slows a little under each box, so the stay shows. Speeds are pixels a second; times are seconds.
  const SPEED = 150;
  const SLOW = 0.75;
  const SPLIT = 0.9;
  const REST = 1;
  const FADE = 0.25;
  const LEAVE = 0.45;

  const figure = document.querySelector<HTMLElement>(".account");
  const visitor = figure?.querySelector<HTMLElement>("[data-from]");
  const fork = figure?.querySelector<HTMLElement>(".fork");
  const dot = figure?.querySelector<HTMLElement>(".flow");
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  if (figure && visitor && fork && dot) {
    const passed = [...figure.querySelectorAll<HTMLElement>(".inside > .node")];
    const stored = [...figure.querySelectorAll<HTMLElement>("[data-store]")];
    const splits = [...figure.querySelectorAll<HTMLElement>(".split")];
    let round: AnimationPlaybackControls | undefined;
    let onScreen = false;

    /** One round of the figure, laid out from where its boxes stand now. */
    const measure = (): AnimationSequence => {
      const from = visitor.getBoundingClientRect();
      const frame = figure.getBoundingClientRect();
      const branch = fork.getBoundingClientRect();
      const down = (passed[0]?.getBoundingClientRect().top ?? 0) >= from.bottom;
      const along = (rect: DOMRect, far: boolean) => {
        const [near, end, start] = down ? [rect.top, rect.bottom, from.bottom] : [rect.left, rect.right, from.right];
        return (far ? end : near) - start;
      };

      // The dot's stops: under each box's near edge, then out from under its far one. The last is the Worker's.
      const stops = [{ place: 0, at: 0 }];
      const answers: [box: HTMLElement, from: number, to: number][] = [[visitor, 0, LEAVE]];
      for (const box of passed) {
        const rect = box.getBoundingClientRect();
        const last = stops.at(-1) ?? { place: 0, at: 0 };
        const into = last.at + (along(rect, false) - last.place) / SPEED;
        const out = into + (along(rect, true) - along(rect, false)) / (SPEED * SLOW);
        stops.push({ place: along(rect, false), at: into }, { place: along(rect, true), at: out });
        answers.push([box, Math.max(into, LEAVE), out]);
      }
      const served = stops.at(-1)?.at ?? 0;
      for (const store of stored) answers.push([store, served + SPLIT * 0.7, served + SPLIT + FADE * 2]);

      const total = served + SPLIT + REST;
      const whole = { duration: total, at: 0 };
      const share = (...times: number[]) => times.map((time) => time / total);
      const startX = down ? from.left + from.width / 2 - frame.left : from.right - frame.left;
      const startY = down ? from.bottom - frame.top : from.top + from.height / 2 - frame.top;
      const places = [...stops, { place: stops.at(-1)?.place ?? 0, at: total }];
      // Every value moved is a place or a plain number, never `opacity`, so all of them run on the library's one clock.
      const sequence: AnimationSequence = [
        [dot, { x: places.map((stop) => startX + (down ? 0 : stop.place)), y: places.map((stop) => startY + (down ? stop.place : 0)) }, { ...whole, times: share(...places.map((stop) => stop.at)), ease: "linear" }],
        [dot, { "--shown": [0, 1, 1, 0, 0] }, { ...whole, times: share(0, FADE, served, served, total), ease: "linear" }],
      ];

      // Each half of the request follows the fork's own lines to the middle of its store, and a little way in.
      stored.forEach((store, index) => {
        const half = splits[index];
        if (!half) return;
        const rect = store.getBoundingClientRect();
        const route = down
          ? `M ${branch.width / 2} 0 V ${branch.height / 2} H ${rect.left + rect.width / 2 - branch.left} V ${branch.height + 10}`
          : `M 0 ${branch.height / 2} H ${branch.width / 2} V ${rect.top + rect.height / 2 - branch.top} H ${branch.width + 10}`;
        half.style.setProperty("offset-path", `path("${route}")`);
        sequence.push(
          [half, { offsetDistance: ["0%", "0%", "100%", "0%", "0%"] }, { ...whole, times: share(0, served, served + SPLIT, served + SPLIT, total), ease: "linear" }],
          [half, { "--shown": [0, 0, 1, 1, 0, 0] }, { ...whole, times: share(0, served, served, served + SPLIT - FADE, served + SPLIT, total), ease: "linear" }],
        );
      });

      // A box answers while the request is under it: its ring comes up, holds, and goes.
      for (const [box, lit, unlit] of answers) {
        const held = Math.max(unlit, lit + FADE);
        sequence.push([box, { "--lit": [0, 0, 1, 1, 0, 0] }, { ...whole, times: share(0, lit, lit + FADE, held, held + FADE, total), ease: ["linear", EASE, "linear", EASE, "linear"] }]);
      }
      return sequence;
    };

    const stop = () => {
      round?.cancel();
      round = undefined;
      for (const moved of [dot, ...splits]) moved.style.removeProperty("--shown");
      for (const box of [visitor, ...passed, ...stored]) box.style.removeProperty("--lit");
    };

    // It runs while the figure is on screen, the tab is showing, and the reader has not asked for less motion.
    const wake = () => {
      stop();
      if (onScreen && !document.hidden && !still.matches) round = animate(measure(), { repeat: Number.POSITIVE_INFINITY });
    };
    inView(figure, () => {
      onScreen = true;
      wake();
      return () => {
        onScreen = false;
        wake();
      };
    });
    document.addEventListener("visibilitychange", wake);
    still.addEventListener("change", wake);
    resize(figure, () => {
      if (round) wake();
    });
  }
</script>

<style>
  /* Every box has one height and every wire is centred on one axis, so each line meets the middle of the edge it joins. */
  .account {
    --box: 60px;
    --gap: 8px;
    --pad: 16px;
    --top: 40px;
    --line: var(--faint);
    position: relative;
    display: flex;
    align-items: center;
    font: 600 0.9375rem / 1.25 var(--sans);
  }

  /* A box is painted above the request's dot, so the dot slides under one edge and out from under the other. */
  /* It answers while the request is under it: the script runs `--lit` from 0 to 1 and back, and the ring follows. */
  .node {
    position: relative;
    z-index: 1;
    flex: none;
    display: grid;
    align-content: center;
    justify-items: center;
    height: var(--box);
    padding-inline: 12px;
    border: 1px solid color-mix(in srgb, var(--accent-text) calc(var(--lit, 0) * 100%), var(--rim, var(--rule)));
    border-radius: 8px;
    background: var(--surface);
    box-shadow: 0 0 0 calc(var(--lit, 0) * 3px) color-mix(in srgb, var(--accent-tint) calc(var(--lit, 0) * 100%), transparent);
    white-space: nowrap;
  }

  small {
    color: var(--muted);
    font-weight: 400;
    font-size: 0.8125rem;
  }

  .worker {
    --rim: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  .worker small {
    color: inherit;
  }

  .wire {
    flex: 1 1 16px;
    min-width: 12px;
    max-width: 104px;
    height: 1px;
    background: var(--line);
  }

  .lead {
    flex: none;
    width: var(--pad);
    min-width: 0;
  }

  /* The account's label sits above the row, so what stands outside is lowered to the row's centre. */
  .out {
    margin-top: calc(var(--top) - var(--pad));
  }

  .inside {
    position: relative;
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    padding: var(--top) var(--pad) var(--pad) 0;
    border-radius: var(--radius);
    background: var(--fill);
  }

  /* A guard the install may not have. */
  .optional {
    border-style: dashed;
  }

  p {
    position: absolute;
    inset: 12px var(--pad) auto;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-weight: 400;
    font-size: 0.8125rem;
    line-height: 16px;
    color: var(--muted);
    white-space: nowrap;
  }

  .key {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .key i {
    width: 16px;
    height: 10px;
    border: 1px dashed var(--faint);
    border-radius: 3px;
  }

  .stores {
    display: flex;
    align-items: center;
  }

  .pair {
    display: grid;
    gap: var(--gap);
  }

  .pair .node {
    min-width: 88px;
  }

  /* A stem from the Worker, then a branch to the middle of each store. */
  .fork {
    position: relative;
    flex: none;
    width: 28px;
    height: calc(2 * var(--box) + var(--gap));
  }

  .fork::before,
  .fork::after {
    content: "";
    position: absolute;
  }

  .fork::before {
    left: 0;
    top: calc(50% - 0.5px);
    width: 50%;
    height: 1px;
    background: var(--line);
  }

  .fork::after {
    left: 50%;
    right: 0;
    top: calc(var(--box) / 2 - 0.5px);
    bottom: calc(var(--box) / 2 - 0.5px);
    border: 1px solid var(--line);
    border-right: 0;
  }

  /* The request: one dot, behind the boxes. */
  .dot {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-text);
    opacity: var(--shown, 0);
    pointer-events: none;
    will-change: transform, opacity;
  }

  /* The script places the request by its centre. */
  .flow {
    margin: -3.5px;
  }

  .split {
    offset-rotate: 0deg;
  }

  /* Narrow: the same path, top to bottom. */
  @media (max-width: 960px) {
    .account,
    .inside,
    .stores {
      flex-direction: column;
    }

    /* The stacked path is a narrow thing, so its frame is too. */
    .account {
      max-width: 400px;
      margin-inline: auto;
    }

    .inside {
      flex: none;
      align-self: stretch;
      padding: 0 var(--pad) var(--pad);
    }

    /* The label goes under the path here, so the wire from the visitor reaches the firewall unbroken. */
    p {
      position: static;
      order: 1;
      align-self: stretch;
      margin-block: 12px 0;
    }

    /* Stacked, the boxes share one width, so the column reads as one built thing. */
    .node {
      width: 148px;
    }

    .wire {
      flex: none;
      width: 1px;
      min-width: 0;
      height: 18px;
    }

    .lead {
      width: 1px;
      height: var(--pad);
    }

    .out {
      margin-top: 0;
    }

    .stores {
      align-self: center;
    }

    .pair {
      grid-template-columns: 1fr 1fr;
      align-self: stretch;
    }

    .pair .node {
      width: auto;
      min-width: 112px;
    }

    .fork {
      align-self: stretch;
      width: auto;
      height: 20px;
    }

    .fork::before {
      left: calc(50% - 0.5px);
      top: 0;
      width: 1px;
      height: 50%;
    }

    .fork::after {
      left: calc(25% - var(--gap) / 4 - 0.5px);
      right: calc(25% - var(--gap) / 4 - 0.5px);
      top: 50%;
      bottom: 0;
      border: 1px solid var(--line);
      border-bottom: 0;
    }
  }
</style>
