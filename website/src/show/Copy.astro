---
import { CopyButton } from "../controls/copy-button.tsx";

interface Props {
  /** What the button copies, shown beside it. */
  command: string;
  /** A word or two saying where it goes, shown before it. */
  label?: string;
  /** Set for a sentence rather than a command: it wraps and is set in the text face. */
  wrap?: boolean;
}

const { command, label, wrap = false } = Astro.props;
// An address inside a sentence, a word that holds a slash, is set in the code face, with a comma after it held to it.
// The split keeps each address as a piece of its own, so the pieces at odd places are the addresses.
const pieces = command.split(/([^\s,]+\/[^\s,]+,?)/);
---

<div class:list={["copy", { wrap }]}>
  {label && <span class="label">{label}</span>}
  {
    wrap ? (
      <p>
        {pieces.map((piece, place) =>
          place % 2 === 1 ? (
            <span class="held">
              <code>
                {piece
                  .replace(/,$/, "")
                  .split("/")
                  .map((part, index) => (
                    <>
                      {index > 0 && "/"}
                      {index > 0 && <wbr />}
                      {part}
                    </>
                  ))}
              </code>{piece.endsWith(",") && ","}
            </span>
          ) : (
            piece
          ),
        )}
      </p>
    ) : (
      <code>{command}</code>
    )
  }
  <CopyButton client:idle command={command} />
</div>

<style>
  /* One rule places every button: the box's padding is the same on both sides and the same above and below, and each
     part is centred on the first line of text, so a button sits mid-row beside one line and on the first line of several. */
  .copy {
    --button: 28px;
    display: inline-flex;
    align-items: start;
    max-width: 100%;
    padding: 7px 14px;
    gap: 12px;
    border-radius: 9px;
    background: var(--fill);
  }

  .wrap {
    padding-block: 9px;
  }

  .label,
  code,
  p {
    padding-block: calc((var(--button) - 1lh) / 2);
  }

  .label {
    flex: none;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  code {
    font-size: 0.8125rem;
    white-space: nowrap;
    overflow-x: auto;
  }

  /* A sentence fills each line up to the button before it takes another. */
  p {
    min-width: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* An address and its comma stay whole on one line wherever a line holds them. Where none does, the address breaks after a slash and nowhere else. */
  .held {
    display: inline-block;
    max-width: 100%;
  }

  p code {
    padding-block: 0;
    white-space: normal;
  }
</style>
