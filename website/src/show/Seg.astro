---
interface Props {
  /** The name the radios share. */
  name: string;
  /** What the group is, for a reader who cannot see it. */
  legend: string;
  /** The choices in order; the first is selected. */
  options: { value: string; label: string }[];
}

const { name, legend, options } = Astro.props;
---

<fieldset class="seg">
  <legend class="vh">{legend}</legend>
  {
    options.map((option, index) => (
      <label>
        <input type="radio" name={name} value={option.value} checked={index === 0} />
        <span>{option.label}</span>
      </label>
    ))
  }
</fieldset>

<style>
  .seg {
    display: inline-grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 3px;
    margin: 0;
    padding: 3px;
    border: 0;
    border-radius: 8px;
    background: var(--fill);
    font: 600 0.875rem / 1.3 var(--sans);
  }

  label {
    position: relative;
    display: block;
    cursor: pointer;
  }

  input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  span {
    display: block;
    padding: 7px 14px;
    border-radius: 5px;
    text-align: center;
    white-space: nowrap;
    color: var(--muted);
  }

  label:hover span {
    color: var(--fg);
  }

  input:checked + span {
    background: var(--fg);
    color: var(--bg);
  }

  input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    span {
      transition:
        background-color 180ms var(--ease),
        color 180ms var(--ease);
    }
  }
</style>
