---
import Check from "@lucide/astro/icons/check";
import X from "@lucide/astro/icons/x";
import { EXAMPLE_PUBLIC_NAME } from "../lib/example.ts";
import Address from "./Address.astro";
import Sign from "./Sign.astro";

// One address, and who it opens for under each access choice. It follows the access choice that the form around it carries.
const PUBLIC_NAME = EXAMPLE_PUBLIC_NAME;
const rows = [
  { who: "You", opens: ["private", "unlisted", "public"] },
  { who: "Anyone with the address", opens: ["unlisted", "public"] },
  { who: "Everyone", opens: ["public"] },
];
const states = ["private", "unlisted", "public"];
---

<div class="who">
  <p class="address">
    <Sign />
    <span class="host"><Address /></span>
  </p>
  <p class="address added swap">
    <span data-show="private unlisted" class="none">no shorter address</span>
    <span data-show="public" class="name">
      also <code>{PUBLIC_NAME}</code>
    </span>
  </p>
  <dl>
    {
      rows.map((row) => (
        <div>
          <dt>{row.who}</dt>
          <dd class="swap">
            {row.opens.length < states.length && (
              <X data-show={states.filter((state) => !row.opens.includes(state)).join(" ")} role="img" aria-label="cannot open it" />
            )}
            <Check data-show={row.opens.join(" ")} class="yes" role="img" aria-label="opens it" />
          </dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .who {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    font: 400 0.875rem / 1.5 var(--sans);
    overflow: hidden;
  }

  .address {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 14px 0;
    color: var(--muted);
    white-space: nowrap;
  }

  /* The second line is always there, so choosing Public moves nothing: it only swaps what the line says. */
  .added {
    display: grid;
    justify-items: start;
    padding-top: 4px;
  }

  .none,
  .name {
    padding-left: 24px;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  code,
  .host {
    min-width: 0;
    overflow: hidden;
    color: var(--fg);
    font-size: clamp(0.625rem, 2.75vw, 0.8125rem);
  }

  dl {
    margin: 10px 0 0;
    border-top: 1px solid var(--rule);
  }

  dl div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 40px;
    padding-inline: 14px;
    border-top: 1px solid var(--rule);
    color: var(--muted);
  }

  dl div:first-child {
    border-top: 0;
  }

  dd.swap > * {
    justify-self: end;
  }

  .yes {
    color: var(--ok);
  }

  /* On a phone the panel gives its padding to the address, so the whole address shows. */
  @media (max-width: 420px) {
    .address {
      gap: 6px;
      padding-inline: 10px;
    }

    .none,
    .name {
      padding-left: 22px;
    }

    dl div {
      padding-inline: 10px;
    }
  }
</style>
