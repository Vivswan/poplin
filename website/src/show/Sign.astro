---
import Globe from "@lucide/astro/icons/globe";
import Link from "@lucide/astro/icons/link";
import Lock from "@lucide/astro/icons/lock";

// The mark beside the address: a lock while private, a link once unlisted, a globe once public. It follows the access
// switch of the form around it.
---

<span class="swap sign" aria-hidden="true">
  <Lock data-show="private" />
  <Link data-show="unlisted" />
  <Globe data-show="public" />
</span>

<style>
  .sign {
    flex: none;
    width: 16px;
    height: 16px;
  }
</style>
