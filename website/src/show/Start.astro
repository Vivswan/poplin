---
import ChevronRight from "@lucide/astro/icons/chevron-right";
import { AgentPicker } from "../controls/agent-picker.tsx";
import { AGENTS } from "../lib/agents.ts";
import { EXAMPLE_DASHBOARD } from "../lib/example.ts";
import { SETUP_PROMPT } from "../lib/paths.ts";
import Copy from "./Copy.astro";

// The first thing offered is one sentence to paste into any agent. Adding it by hand stays one click away.
---

<div class="start" data-picked={AGENTS[0]?.id}>
  <Copy command={SETUP_PROMPT} wrap />

  <details class="byhand">
    <summary>
      <ChevronRight class="chev" />
      Or add it yourself
    </summary>
    <div class="steps">
      <Copy label="Once" command={`npx poplin login --server https://${EXAMPLE_DASHBOARD}`} />
      <div class="pick">
        <div class="then">
          <span>Then, in</span>
          <AgentPicker client:idle agents={AGENTS.map((agent) => ({ value: agent.id, label: agent.name }))} />
        </div>
        <span class="where">
          {AGENTS.map((agent) => <code data-agent={agent.id}>{agent.where}</code>)}
        </span>
      </div>
      <div class="agent">
        {
          AGENTS.map((agent) => (
            <div data-agent={agent.id}>
              <Copy label={agent.where ? "Add" : "Run"} command={agent.line} />
            </div>
          ))
        }
      </div>
      <Copy label="Terminal" command="npm i -g poplin" />
    </div>
  </details>
</div>

<style>
  .start {
    display: grid;
    gap: 18px;
    justify-items: start;
    min-width: 0;
    font-size: 0.875rem;
  }

  /* The block is as wide as its column and no wider, whatever the longest line inside it. */
  .byhand {
    width: 100%;
    min-width: 0;
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    vertical-align: top;
    color: var(--muted);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .chev {
    margin: -2px 0 -2px -2px;
  }

  details[open] .chev {
    transform: rotate(90deg);
  }

  /* The rows share one surface: a row is a line of it, with its label, its command, and its button each in one column. */
  .steps :global(.copy) {
    display: flex;
    align-items: start;
    width: 100%;
    border-radius: 0;
    background: none;
  }

  .steps :global(.copy code) {
    flex: 1;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .steps :global(.label),
  .then > span:first-child {
    flex: none;
    width: 4.75rem;
  }

  summary:hover {
    color: var(--fg);
  }

  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: stretch;
    width: 100%;
    min-width: 0;
    margin-top: 16.5px;
    border-radius: 9px;
    background: var(--fill);
    overflow: hidden;
  }

  .steps > :global(* + *) {
    border-top: 1px solid var(--rule);
  }

  /* The picker's row; the file an agent reads, if it reads one, follows its name. */
  .pick {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 42px;
    padding: 3px 14px;
    color: var(--muted);
  }

  .then {
    display: flex;
    align-items: center;
  }

  /* The library keeps an unseen input beside the picker, for a form to send, fixed to the window. No form sends this
     pick, and a fixed element makes a phone's browser draw the corners of the table above differently, so it is left out. */
  .then :global(input) {
    display: none;
  }

  .where {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: 0.8125rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Only the chosen agent's line is there, so its row is exactly as tall as that line. */
  [data-agent] {
    display: none;
    min-width: 0;
    max-width: 100%;
  }

  /* On a phone the file's name takes its own line under the picker. */
  @media (max-width: 720px) {
    .pick {
      flex-wrap: wrap;
      gap: 6px 12px;
      padding-block: 8px;
    }

    .where {
      flex-basis: 100%;
    }
  }
</style>
