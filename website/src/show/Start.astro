---
import { Fold } from "../controls/fold.tsx";
import { Picker } from "../controls/picker.tsx";
import { AGENTS, SKILL_LINE } from "../lib/agents.ts";
import { INSTALLS } from "../lib/installs.ts";
import { SETUP_PROMPT } from "../lib/prompt.ts";
import Copy from "./Copy.astro";

// The first thing offered is one sentence to paste into any agent. Installing and adding it by hand stays one click away.
---

<div class="start" data-picked={AGENTS[0]?.id} data-install={INSTALLS[0]?.id}>
  <Copy command={SETUP_PROMPT} wrap />

  <Fold client:load id="by-hand" label="Or install it yourself">
    <div class="steps">
      <div class="pick asks">
        <div class="then">
          <span>Install</span>
          <Picker client:idle name="install" legend="Kind of install" options={INSTALLS.map((install) => ({ value: install.id, label: install.name }))} />
        </div>
        <span class="where">Asks for an email and an account token</span>
      </div>
      <div>
        {
          INSTALLS.map((install) => (
            <div data-kind={install.id}>
              <Copy label="Run" command={install.line} />
            </div>
          ))
        }
      </div>
      <div>
        {
          INSTALLS.map((install) => (
            <div data-kind={install.id}>
              <Copy label="Once" command={install.login} />
            </div>
          ))
        }
      </div>
      <div class="pick">
        <div class="then">
          <span>Then, in</span>
          <Picker client:idle name="picked" legend="Your agent" options={AGENTS.map((agent) => ({ value: agent.id, label: agent.name }))} />
        </div>
        <span class="where">
          {AGENTS.map((agent) => <code data-agent={agent.id}>{agent.where}</code>)}
        </span>
      </div>
      <div class="agent">
        {
          AGENTS.map((agent) => (
            <div data-agent={agent.id}>
              <Copy label={agent.where ? "Add" : "Run"} command={agent.line} />
            </div>
          ))
        }
      </div>
      <Copy label="Skill" command={SKILL_LINE} />
      <Copy label="Terminal" command="npm i -g poplin" />
    </div>
  </Fold>
</div>

<style>
  .start {
    display: grid;
    gap: 18px;
    justify-items: start;
    min-width: 0;
    font-size: 0.875rem;
  }

  /* Where no script runs nothing can open the fold, so it stands open. */
  :global(:root:not(.js)) .start :global([data-slot="collapsible-content"][hidden]) {
    display: block;
    content-visibility: visible;
  }

  /* The rows share one surface: a row is a line of it, with its label, its command, and its button each in one column. */
  .steps :global(.copy) {
    display: flex;
    align-items: start;
    width: 100%;
    border-radius: 0;
    background: none;
  }

  .steps :global(.copy code) {
    flex: 1;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .steps :global(.label),
  .then > span:first-child {
    flex: none;
    width: 4.75rem;
  }

  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: stretch;
    width: 100%;
    min-width: 0;
    margin-top: 16.5px;
    border-radius: 9px;
    background: var(--fill);
    overflow: hidden;
  }

  .steps > :global(* + *) {
    border-top: 1px solid var(--rule);
  }

  /* A picker's row. What follows the pick is what the install asks, or the file an agent reads, if it reads one. */
  .pick {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 42px;
    padding: 3px 14px;
    color: var(--muted);
  }

  .then {
    display: flex;
    align-items: center;
  }

  /* The library keeps an unseen input beside the picker, for a form to send, fixed to the window. No form sends this
     pick, and a fixed element makes a phone's browser draw the corners of the table above differently, so it is left out. */
  .then :global(input) {
    display: none;
  }

  .where {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: 0.8125rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Only the line of what was picked is there, so its row is exactly as tall as that line. */
  [data-agent],
  [data-kind] {
    display: none;
    min-width: 0;
    max-width: 100%;
  }

  /* On a phone what follows the pick takes its own line under the picker. What the install asks is a sentence, which
     is never cut short: it takes its own line as soon as the column beside the words is too narrow for it. */
  @media (max-width: 1000px) {
    .asks {
      flex-wrap: wrap;
      gap: 6px 12px;
      padding-block: 8px;
    }

    .asks .where {
      flex-basis: 100%;
    }
  }

  @media (max-width: 720px) {
    .pick {
      flex-wrap: wrap;
      gap: 6px 12px;
      padding-block: 8px;
    }

    .where {
      flex-basis: 100%;
    }
  }
</style>
