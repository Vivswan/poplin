---
import { EXAMPLE_ADDRESS } from "../lib/example.ts";

// The example site's address. One letter in it says who can open the site, so it follows the access switch of the form
// around it: p while private, u once unlisted or public. Both letters are one character wide, so nothing moves.
const { before, letters, after } = EXAMPLE_ADDRESS;
---

<code class="address">{before}<span class="swap letter">{letters.map((letter) => <span data-show={letter.shows}>{letter.is}</span>)}</span>{after}</code>

<style>
  .address {
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .letter {
    display: inline-grid;
    border-radius: 3px;
    background: color-mix(in srgb, var(--accent) 26%, transparent);
    color: var(--accent-text);
    font-weight: 700;
  }

  /* The letter that has just changed is lit for a moment: the page's script runs `--lit` from 1 to 0. */
  .letter span {
    background: color-mix(in srgb, var(--accent) calc(var(--lit, 0) * 100%), transparent);
    color: color-mix(in srgb, var(--on-accent) calc(var(--lit, 0) * 100%), var(--accent-text));
  }
</style>
