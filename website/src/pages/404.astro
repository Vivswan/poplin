---
import Site from "../layouts/Site.astro";
import { sitePath } from "../lib/paths.ts";
---

<Site title="Page not found: poplin" description="This address has no page on the poplin website." path="404.html">
  <section class="wrap none">
    <h1>No page here.</h1>
    <p><a href={sitePath()}>Home</a></p>
  </section>
</Site>

<style>
  .none {
    padding-block: clamp(48px, 12vh, 120px);
  }

  p {
    margin-top: 16px;
  }
</style>
