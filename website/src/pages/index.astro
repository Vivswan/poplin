---
import Site from "../layouts/Site.astro";
import Account from "../show/Account.astro";
import Ask from "../show/Ask.astro";
import { PROVIDERS } from "../lib/providers.ts";
import { SETUP_PROMPT } from "../lib/paths.ts";
import Browser from "../show/Browser.astro";
import Compare from "../show/Compare.astro";
import Copy from "../show/Copy.astro";
import Provider from "../show/Provider.astro";
import Seg from "../show/Seg.astro";
import Sites from "../show/Sites.astro";
import Start from "../show/Start.astro";
import Who from "../show/Who.astro";
import { AGENTS } from "../lib/agents.ts";

// The running demo gets a link only when the build is given its https address.
const demoUrl = URL.parse(process.env.DEMO_URL ?? "");
const demo = demoUrl?.protocol === "https:" ? demoUrl.href : undefined;

// The agent picker is a native select read by CSS: one rule puts the chosen agent's line on the page.
const pickerRules = `${AGENTS.map((agent) => `.byhand:has(option[value="${agent.id}"]:checked) [data-agent="${agent.id}"]`).join(",")}{display:revert}`;

---

<Site
  title="Poplin: ask your agent, and your site is online"
  description={`Poplin publishes a folder as a website on your own ${PROVIDERS[0]}, from an agent or the terminal: private by default, unlisted, or public.`}
  path=""
>
  <style slot="head" is:inline set:html={pickerRules}></style>
  <div class="wrap">
    <section class="hero" aria-labelledby="title">
      <h1 id="title">Ask your agent. Your site is online.</h1>
      <p>Poplin publishes a folder as a website, on your own <Provider end="." /></p>
      <div class="paste">
        <p>Paste into your agent</p>
        <Copy command={SETUP_PROMPT} wrap />
      </div>
    </section>

    <!-- One path from the request to the site. The form carries the two switches, so they work with no script. -->
    <form class="access path" data-play aria-label="From a request to a site" onsubmit="return false">
      <section class="step" aria-labelledby="ask">
        <div class="say">
          <h2 id="ask">Ask, or type</h2>
          <p>Give your agent a folder. Or run one command in a terminal.</p>
          <Seg
            name="door"
            legend="How you publish"
            options={[
              { value: "agent", label: "Agent" },
              { value: "terminal", label: "Terminal" },
            ]}
          />
        </div>
        <Ask />
        <i class="runner" aria-hidden="true"></i>
      </section>

      <section class="step" aria-labelledby="site">
        <div class="say">
          <h2 id="site">It becomes a site</h2>
          <p>The address you get back opens the page. At first, only you can open it: the p in it means private.</p>
        </div>
        <Browser />
      </section>

      <section class="step" aria-labelledby="who">
        <div class="say">
          <h2 id="who">Choose who opens it</h2>
          <p>Unlisted opens it to anyone with the address; public, to everyone, at a shorter address too. One letter in the address says which: p&nbsp;private, u&nbsp;unlisted.</p>
          <Seg
            name="access"
            legend="Who can open it"
            options={[
              { value: "private", label: "Private" },
              { value: "unlisted", label: "Unlisted" },
              { value: "public", label: "Public" },
            ]}
          />
        </div>
        <Who />
      </section>

      <section class="step" aria-labelledby="sites">
        <div class="say">
          <h2 id="sites">Every site in one place</h2>
          <p>A private dashboard lists your sites. Update one, roll it back, or delete it.</p>
          {
            demo !== undefined && (
              <a class="more" href={demo}>
                See the dashboard
                <svg viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M4.5 2.5L8 6l-3.500 3.500" />
                </svg>
              </a>
            )
          }
        </div>
        <Sites />
      </section>

      <section class="step wide" aria-labelledby="yours">
        <div class="say">
          <h2 id="yours">It runs in your account</h2>
          <p>Every request passes your guards first, and a private site adds a login. The free plan covers 100,000 requests a day. Past that, the sites pause until midnight UTC.</p>
        </div>
        <Account />
      </section>

      <section class="step wide" aria-labelledby="differs">
        <div class="say">
          <h2 id="differs">Beside other tools</h2>
          <p>Checked against each tool's own pages.</p>
        </div>
        <Compare />
      </section>

      <section class="step last" aria-labelledby="start">
        <div class="say">
          <h2 id="start">Start</h2>
          <p>Paste this into your agent; it guides you through the rest. It needs a free account on <Provider end="." /></p>
        </div>
        <Start />
      </section>
    </form>
  </div>
</Site>

<style>
  .hero {
    padding-block: clamp(36px, 8vh, 80px) clamp(40px, 6vw, 64px);
  }

  .hero > p {
    margin-top: 14px;
    color: var(--muted);
    font-size: 1.125rem;
    text-wrap: pretty;
  }

  /* The first thing a visitor can do, right under what the product is. */
  .paste {
    margin-top: 28px;
  }

  .paste :global(.copy) {
    display: flex;
    align-items: center;
  }

  .paste :global(.copy p) {
    flex: 1;
  }

  .paste > p {
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  /* The rail runs the whole way down; each step hangs a dot on it. */
  .path {
    position: relative;
    padding-left: 28px;
  }

  .path::before {
    content: "";
    position: absolute;
    left: 3px;
    top: 8px;
    bottom: 12px;
    width: 1px;
    background: var(--rule);
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 252px minmax(0, 1fr);
    gap: 20px 40px;
    align-items: start;
    padding-bottom: clamp(48px, 6vw, 72px);
  }

  .wide {
    grid-template-columns: minmax(0, 1fr);
  }

  .last {
    padding-bottom: 0;
  }

  .step::before,
  .runner {
    content: "";
    position: absolute;
    left: -28px;
    top: 7px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .step::before {
    background: var(--bg);
    box-shadow: inset 0 0 0 1.5px var(--muted);
  }

  .runner {
    background: var(--accent);
    opacity: 0;
  }

  .say p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* A sentence above a full-width figure keeps a reading measure. */
  .wide .say p {
    max-width: 62ch;
  }

  /* A plain link in the accent ink, with the page's small arrow: the way to the running demo, when there is one. */
  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    color: var(--accent-text);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }

  .more svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .say :global(.seg) {
    margin-top: 16px;
  }

  .wrap {
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  /* The publish travels down the rail from the request to the site. */
  @media (prefers-reduced-motion: no-preference) {
    .path.play .runner {
      animation: travel 400ms var(--ease) 1450ms both;
    }
  }

  @keyframes travel {
    from {
      top: 7px;
      opacity: 1;
    }

    85% {
      opacity: 1;
    }

    to {
      top: 100%;
      opacity: 0;
    }
  }

  @media (max-width: 720px) {
    .path {
      padding-left: 20px;
    }

    .step {
      grid-template-columns: minmax(0, 1fr);
    }

    .step::before,
    .runner {
      left: -20px;
    }
  }
</style>
