---
import Page from "../layouts/Page.astro";
import { REPOSITORY_URL, sitePath } from "../lib/paths.ts";

const CELL_COUNT = 32;
const OWNER_CELL = 11;
const LINK_HOLDER_CELLS = [2, 6, 13, 20, 25, 30];
const everyCell = Array.from({ length: CELL_COUNT }, (_, cell) => cell);
const states = [
  {
    name: "Private",
    note: "the default",
    address: "page-report.example.com",
    who: "Only you, after one login.",
    others: [] as number[],
  },
  {
    name: "Unlisted",
    note: "you choose",
    address: "page-report--7f3k9x2mq4ab.example.com",
    who: "Anyone with the secret link.",
    others: LINK_HOLDER_CELLS,
  },
  {
    name: "Public",
    note: "you choose",
    address: "page-report.example.com",
    who: "Everyone.",
    others: everyCell,
  },
];

function cellKind(cell: number, others: number[]): string {
  if (cell === OWNER_CELL) {
    return "you";
  }
  return others.includes(cell) ? "other" : "closed";
}
---

<Page
  title="Poplin: agents publish static sites to your own Cloudflare account"
  description="One call publishes a folder or one HTML file to your own Cloudflare account. Private by default, shareable by secret link, or public."
  path=""
>
  <section class="hero wrap">
    <div class="hero-words">
      <h1>Your agent publishes the site. Only you can open it.</h1>
      <p class="lede">
        One call puts a folder, or one HTML file, on your own Cloudflare account. It stays private until you share it.
      </p>
      <p class="status-line">
        <span class="tag">In development</span>
        Not released.
      </p>
    </div>
    <div class="cloth">
      <figure class="term">
        <pre><code><span class="prompt" aria-hidden="true">$ </span><span class="typed">poplin ./report</span>
<span class="out addr">https://page-report.example.com</span>
<span class="out dim">private: only you, after one login</span></code></pre>
        <figcaption>An agent, or you, publishes with one call. The address comes back.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="states">
    <h2 id="states">Three states. You pick who gets in.</h2>
    <ul class="states">
      {
        states.map((state) => (
          <li class="state">
            <div class="swatch" aria-hidden="true">
              {everyCell.map((cell) => (
                <span class={cellKind(cell, state.others)} />
              ))}
            </div>
            <h3>
              {state.name} <span class="aside">{state.note}</span>
            </h3>
            <p>{state.who}</p>
            <p class="address">{state.address}</p>
          </li>
        ))
      }
    </ul>
    <p class="key">
      <span class="chip you" aria-hidden="true"></span> you <span class="chip other" aria-hidden="true"></span> someone else who can open it
    </p>
    <p class="plain">
      A state changes in place. The site, its files, and its short address stay. An unlisted site also gets a secret
      link, and you can rotate that link if it leaks.
    </p>
  </section>

  <section class="section wrap" aria-labelledby="how">
    <h2 id="how">One Worker, one bucket, your account.</h2>
    <figure class="flow">
      <ul class="flow-col">
        <li class="node">
          <strong>An agent</strong>
          <span>connects over MCP</span>
        </li>
        <li class="node">
          <strong>A person</strong>
          <span>uses the CLI or the index page</span>
        </li>
      </ul>
      <p class="thread"><span>publish</span></p>
      <div class="account">
        <p class="account-name">Your Cloudflare account</p>
        <div class="node solid">
          <strong>One Worker</strong>
          <span>serves every site, your index page, and the MCP server</span>
        </div>
        <p class="thread short" aria-hidden="true"></p>
        <div class="node solid">
          <strong>One bucket</strong>
          <span>a folder per site, with its versions</span>
        </div>
      </div>
      <p class="thread"><span>open</span></p>
      <ul class="flow-col">
        <li class="node">
          <strong>You</strong>
          <span>private sites, after one login</span>
        </li>
        <li class="node">
          <strong>Anyone with the link</strong>
          <span>unlisted sites</span>
        </li>
        <li class="node">
          <strong>Everyone</strong>
          <span>public sites</span>
        </li>
      </ul>
      <figcaption>
        Nothing runs outside Cloudflare, so there is no server to keep up. The Worker never reads or rewrites a site's
        files.
      </figcaption>
    </figure>
  </section>

  <section class="section wrap" aria-labelledby="manage">
    <h2 id="manage">One page lists every site.</h2>
    <div class="manage">
      <figure class="mock">
        <table>
          <caption>Your sites</caption>
          <thead>
            <tr>
              <th scope="col">Site</th>
              <th scope="col">State</th>
              <th scope="col">Note</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">report</th>
              <td><span class="pill private">private</span></td>
              <td>3 versions</td>
            </tr>
            <tr>
              <th scope="row">launch-deck</th>
              <td><span class="pill unlisted">unlisted</span></td>
              <td>secret link</td>
            </tr>
            <tr>
              <th scope="row">trip-summary</th>
              <td><span class="pill public">public</span></td>
              <td>2 versions</td>
            </tr>
            <tr>
              <th scope="row">checkout-prototype</th>
              <td><span class="pill private">private</span></td>
              <td>expires in 6 days</td>
            </tr>
            <tr>
              <th scope="row" class="struck">old-demo</th>
              <td><span class="pill trash">in the trash</span></td>
              <td>can be undeleted</td>
            </tr>
          </tbody>
        </table>
        <figcaption>A sketch of the owner's index page, not a screenshot.</figcaption>
      </figure>
      <dl class="can">
        <div>
          <dt>Versions and rollback</dt>
          <dd>A site keeps its last few versions. Rolling back switches the live one, with no upload.</dd>
        </div>
        <div>
          <dt>A trash with undo</dt>
          <dd>A deleted site waits in the trash first. Undelete brings it back.</dd>
        </div>
        <div>
          <dt>Expiry</dt>
          <dd>Give a throwaway demo an end date. It moves to the trash that day.</dd>
        </div>
        <div>
          <dt>Export</dt>
          <dd>Take everything out as one zip.</dd>
        </div>
        <div>
          <dt>Three ways in</dt>
          <dd>MCP for agents, a CLI for people, and an npm package.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="why">
    <h2 id="why">Private is the default, not a paid tier.</h2>
      <table class="grid">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Question</span></th>
            <th scope="col">Many hosts</th>
            <th scope="col">Poplin</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">A private page</th>
            <td data-label="Many hosts">a paid tier</td>
            <td data-label="Poplin">the default</td>
          </tr>
          <tr>
            <th scope="row">Sharing with a few people</th>
            <td data-label="Many hosts">a login</td>
            <td data-label="Poplin">a secret link, as shared documents work</td>
          </tr>
        </tbody>
      </table>
    <p class="plain">
      Your pages sit in your own Cloudflare account. The four closest tools are on the <a href={sitePath("compare/")}>compare page</a>.
    </p>
  </section>

  <section class="section wrap" aria-labelledby="cost">
    <h2 id="cost">It fits Cloudflare's free tier.</h2>
      <table class="grid">
        <thead>
          <tr>
            <th scope="col">Piece</th>
            <th scope="col">What it does</th>
            <th scope="col">Free tier</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Worker</th>
            <td data-label="What it does">serves the sites</td>
            <td data-label="Free tier">100,000 requests a day. It stops at the limit and never bills.</td>
          </tr>
          <tr>
            <th scope="row">Bucket</th>
            <td data-label="What it does">stores the sites</td>
            <td data-label="Free tier">10 GB, with no egress fee</td>
          </tr>
          <tr>
            <th scope="row">Login</th>
            <td data-label="What it does">lets you in</td>
            <td data-label="Free tier">free for 50 users</td>
          </tr>
          <tr>
            <th scope="row">Address</th>
            <td data-label="What it does">where sites open</td>
            <td data-label="Free tier">the account's free workers.dev address, or a domain you already have</td>
          </tr>
        </tbody>
      </table>
    <ul class="notes">
      <li>
        <strong>Guards.</strong> A storage cap, a size cap per site, and request limits per site and per visitor. Poplin
        refuses an upload past the storage cap, because the bucket bills past its free tier.
      </li>
      <li>
        <strong>The one limit it cannot fully guard.</strong> A flood of requests can stop the sites until midnight
        UTC. It costs no money.
      </li>
      <li>
        <strong>No domain needed to start.</strong> Without one the guarantees are <a href={sitePath("docs/security.html#without-a-domain")}>narrower</a>. Adding a domain switches on the full
        set.
      </li>
    </ul>
  </section>

  <section class="section wrap status" aria-labelledby="status">
    <h2 id="status">In development. Not released.</h2>
    <p class="plain">This site shows no install command. The source and the docs are public.</p>
    <p class="actions">
      <a class="button" href={REPOSITORY_URL}>Open the repository</a>
      <a class="button quiet" href={sitePath("docs/")}>Read the docs</a>
      <a class="button quiet" href={sitePath("demo/")}>See the demo</a>
    </p>
  </section>
</Page>
