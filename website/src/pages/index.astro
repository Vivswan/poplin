---
import ChevronRight from "@lucide/astro/icons/chevron-right";
import { Choice } from "../controls/choice.tsx";
import Site from "../layouts/Site.astro";
import Account from "../show/Account.astro";
import Ask from "../show/Ask.astro";
import { PROVIDERS } from "../lib/providers.ts";
import { SETUP_PROMPT } from "../lib/paths.ts";
import Browser from "../show/Browser.astro";
import Compare from "../show/Compare.astro";
import Copy from "../show/Copy.astro";
import Provider from "../show/Provider.astro";
import Sites from "../show/Sites.astro";
import Start from "../show/Start.astro";
import Who from "../show/Who.astro";
import { AGENTS } from "../lib/agents.ts";
import { demoAddress } from "../lib/demo.ts";

const demo = demoAddress();

// The Start block carries the picked agent, and one rule puts that agent's line on the page.
const pickerRules = `${AGENTS.map((agent) => `.start[data-picked="${agent.id}"] [data-agent="${agent.id}"]`).join(",")}{display:revert}`;

---

<Site
  title="Poplin: ask your agent, and your site is online"
  description={`Poplin publishes a folder as a website on your own ${PROVIDERS[0]}, from an agent or the terminal: private by default, unlisted, or public.`}
  path=""
>
  <style slot="head" is:inline set:html={pickerRules}></style>
  <div class="wrap">
    <section class="hero" aria-labelledby="title">
      <h1 id="title">Ask your agent. Your site is online.</h1>
      <p>Poplin publishes a folder as a website, on your own <Provider end="." /></p>
      <div class="paste">
        <p>Paste into your agent</p>
        <Copy command={SETUP_PROMPT} wrap />
      </div>
    </section>

    <!-- One path from the request to the site. The form carries what the two switches chose, and the stylesheet shows it. -->
    <form class="access path" aria-label="From a request to a site" onsubmit="return false" data-door="agent" data-access="private">
      <section class="step" aria-labelledby="ask">
        <div class="say">
          <h2 id="ask">Ask, or type</h2>
          <p>Give your agent a folder. Or run one command in a terminal.</p>
          <Choice
            client:idle
            name="door"
            legend="How you publish"
            options={[
              { value: "agent", label: "Agent" },
              { value: "terminal", label: "Terminal" },
            ]}
          />
        </div>
        <Ask />
        <i class="runner" aria-hidden="true"></i>
      </section>

      <section class="step" aria-labelledby="site">
        <div class="say">
          <h2 id="site">It becomes a site</h2>
          <p>The address you get back opens the page. At first, only you can open it: the p in it means private.</p>
        </div>
        <Browser />
      </section>

      <section class="step" aria-labelledby="who">
        <div class="say">
          <h2 id="who">Choose who opens it</h2>
          <p>Unlisted opens it to anyone with the address; public, to everyone, at a shorter address too. One letter in the address says which: p&nbsp;private, u&nbsp;unlisted.</p>
          <Choice
            client:idle
            name="access"
            legend="Who can open it"
            options={[
              { value: "private", label: "Private" },
              { value: "unlisted", label: "Unlisted" },
              { value: "public", label: "Public" },
            ]}
          />
        </div>
        <Who />
      </section>

      <section class="step" aria-labelledby="sites">
        <div class="say">
          <h2 id="sites">Every site in one place</h2>
          <p>A private dashboard lists your sites. Update one, roll it back, or delete it.</p>
          {
            demo !== undefined && (
              <a class="more" href={demo}>
                See the dashboard
                <ChevronRight />
              </a>
            )
          }
        </div>
        <Sites />
      </section>

      <section class="step wide" aria-labelledby="yours">
        <div class="say">
          <h2 id="yours">It runs in your account</h2>
          <p>Every request passes the guards you add, and a private site adds a login. The free plan covers 100,000 requests a day. Past that, the sites pause until midnight UTC.</p>
        </div>
        <Account />
      </section>

      <section class="step wide" aria-labelledby="differs">
        <div class="say">
          <h2 id="differs">Beside other tools</h2>
          <p>Checked against each tool's own pages.</p>
        </div>
        <Compare />
      </section>

      <section class="step last" aria-labelledby="start">
        <div class="say">
          <h2 id="start">Start</h2>
          <p>Paste this into your agent; it guides you through the rest. It needs a free account on <Provider end="." /></p>
        </div>
        <Start />
      </section>
    </form>
  </div>
</Site>

<script>
  import { animate, inView, scopeMotion } from "motion";
  import { EASE } from "../lib/ease.ts";

  // How long the request takes, in seconds: the browser's frame arrives when it is done.
  const REQUEST = 1.75;
  const FADE = 0.22;
  const arrive = { opacity: [0, 1], transform: ["translateY(6px)", "none"] };
  const root = document.documentElement;
  const path = document.querySelector<HTMLElement>(".path");
  const runner = path?.querySelector<HTMLElement>(".runner");
  const shows = [...(path?.querySelectorAll<HTMLElement>("[data-show]") ?? [])];
  const opens = (part: HTMLElement, choice: string) => part.dataset.show?.split(" ").includes(choice) ?? false;

  // The mark is set before the first paint; if less motion was asked for since, nothing here will play, so nothing waits unseen.
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) root.classList.remove("moves");

  // Everything that moves lives in one scope, which stands only while the reader has not asked for less motion. When
  // they ask, the library stops it all and puts every style back, and the stylesheet alone runs the switch.
  scopeMotion(
    (scope) => {
      // The page's first script marks the root when what plays may play; the same mark hides it until it does.
      if (!path || !runner || !root.classList.contains("moves")) return;

      // The request plays once, when the path comes into view: the ask, the tool at work, the answer, and the dot that
      // carries it down the rail. The frame waits for the request to finish, and no longer than that.
      // Each part's fade and move are `opacity` and `transform`, which the library hands to one engine, so they stay in step.
      inView(path, () => {
        const asked = performance.now();
        const fall = (runner.parentElement?.clientHeight ?? 0) - runner.offsetTop;
        animate([
          [".ask .you", arrive, { duration: 0.35, ease: EASE, at: 0 }],
          [".ask .tool", arrive, { duration: 0.35, ease: EASE, at: 0.4 }],
          [".ask .spin", { transform: ["rotate(0deg)", "rotate(540deg)"] }, { duration: 0.7, ease: "linear", at: 0.4 }],
          [".ask .spin", { opacity: [1, 1, 0] }, { duration: 0.7, times: [0, 0.85, 1], ease: "linear", at: 0.4 }],
          [".ask .done", arrive, { duration: 0.2, ease: EASE, at: 1.1 }],
          [".ask .reply", arrive, { duration: 0.35, ease: EASE, at: 1.3 }],
          [runner, { transform: ["translateY(0px)", `translateY(${fall}px)`] }, { duration: 0.4, ease: EASE, at: 1.45 }],
          [runner, { opacity: [1, 1, 0] }, { duration: 0.4, times: [0, 0.85, 1], ease: ["linear", EASE], at: 1.45 }],
        ]);
        inView(".browser", (frame) => {
          const wait = Math.max(0, REQUEST - (performance.now() - asked) / 1000);
          animate([
            [frame, arrive, { duration: 0.35, ease: EASE, at: wait }],
            [".browser .view", { opacity: [0, 1], clipPath: ["inset(0% 0% 100% 0%)", "inset(0% 0% 0% 0%)"] }, { duration: 0.55, ease: EASE, at: wait + 0.4 }],
          ]);
        });
      });

      // The access switch: the stylesheet alone decides what each choice shows, and this paces the change. What leaves
      // fades out as what arrives fades in, and the address's letter is lit for a moment when it changes.
      const fade = (choice: string, duration: number) => {
        for (const part of shows) {
          animate(part, { opacity: opens(part, choice) ? 1 : 0, visibility: opens(part, choice) ? "visible" : "hidden" }, { duration, ease: EASE });
        }
      };
      let chosen = path.dataset.access ?? "";
      fade(chosen, 0);
      // Either switch says `choice`; the form carries what was chosen, so only a new access choice is paced.
      const pace = scope.bind(() => {
        const choice = path.dataset.access ?? "";
        if (choice === chosen) return;

        fade(choice, FADE);
        for (const letter of shows) {
          if (letter.closest(".letter") && opens(letter, choice) && !opens(letter, chosen)) animate(letter, { "--lit": [1, 0] }, { duration: 0.7, ease: EASE });
        }
        chosen = choice;
      });
      path.addEventListener("choice", pace);

      return () => {
        path.removeEventListener("choice", pace);
        root.classList.remove("moves");
      };
    },
    { matchMedia: "(prefers-reduced-motion: no-preference)" },
  );
</script>

<style>
  .hero {
    padding-block: clamp(36px, 8vh, 80px) clamp(40px, 6vw, 64px);
  }

  .hero > p {
    margin-top: 14px;
    color: var(--muted);
    font-size: 1.125rem;
    text-wrap: pretty;
  }

  /* The first thing a visitor can do, right under what the product is. */
  .paste {
    margin-top: 28px;
  }

  .paste :global(.copy) {
    display: flex;
  }

  .paste :global(.copy p) {
    flex: 1;
  }

  .paste > p {
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  /* The rail runs the whole way down; each step hangs a dot on it. */
  .path {
    position: relative;
    padding-left: 28px;
  }

  .path::before {
    content: "";
    position: absolute;
    left: 3px;
    top: 8px;
    bottom: 12px;
    width: 1px;
    background: var(--rule);
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 252px minmax(0, 1fr);
    gap: 20px 40px;
    align-items: start;
    padding-bottom: clamp(48px, 6vw, 72px);
  }

  .wide {
    grid-template-columns: minmax(0, 1fr);
  }

  .last {
    padding-bottom: 0;
  }

  .step::before,
  .runner {
    content: "";
    position: absolute;
    left: -28px;
    top: 7px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .step::before {
    background: var(--bg);
    box-shadow: inset 0 0 0 1.5px var(--muted);
  }

  /* The publish travels down the rail from the request to the site, by the page's script. */
  .runner {
    background: var(--accent);
    opacity: 0;
  }

  .say p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* A sentence above a full-width figure keeps a reading measure. */
  .wide .say p {
    max-width: 62ch;
  }

  /* A plain link in the accent ink, with the page's small arrow: the way to the running demo, when there is one. */
  .more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 14px;
    color: var(--accent-text);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }

  .say :global([data-slot="toggle-group"]) {
    margin-top: 16px;
  }

  .wrap {
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  /* In a wide window the column is wider: the words get more room, and a picture grows only a little. */
  @media (min-width: 1250px) {
    .step:not(.wide) {
      grid-template-columns: minmax(0, 1fr) 640px;
      column-gap: 64px;
    }

    .step:not(.wide) .say p {
      max-width: 340px;
    }
  }

  @media (max-width: 720px) {
    .path {
      padding-left: 20px;
    }

    .step {
      grid-template-columns: minmax(0, 1fr);
    }

    .step::before,
    .runner {
      left: -20px;
    }
  }
</style>
