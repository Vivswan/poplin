---
import "@fontsource/libre-franklin/latin-400.css";
import "@fontsource/libre-franklin/latin-600.css";
import "@fontsource/libre-franklin/latin-700.css";
import "../styles/theme.css";
import Monitor from "@lucide/astro/icons/monitor";
import Moon from "@lucide/astro/icons/moon";
import Sun from "@lucide/astro/icons/sun";
import { getImage } from "astro:assets";
import { REPOSITORY_URL, sitePath } from "../lib/paths.ts";
import { released } from "../lib/released.ts";

interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
const pageUrl = new URL(sitePath(path), Astro.site).href;
const newest = released();
const links = [
  { href: sitePath("docs/"), label: "Docs" },
  { href: REPOSITORY_URL, label: "GitHub" },
];

const brand = import.meta.glob<ImageMetadata>("../../../brand/{favicon,icon,social}.svg", { eager: true, import: "default" });
const favicon = brand["../../../brand/favicon.svg"];
const icon = brand["../../../brand/icon.svg"];
const social = brand["../../../brand/social.svg"];
if (favicon === undefined || icon === undefined || social === undefined) {
  throw new Error("The brand folder is missing its favicon, icon, or social drawing.");
}
const touchIcon = await getImage({ src: icon, width: 180, height: 180, format: "png" });
const card = await getImage({ src: social, width: 1200, height: 630, format: "png" });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={favicon.src} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Poplin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={new URL(card.src, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <script is:inline>
      // Runs before the first paint, so a remembered theme never flashes the other one, and what plays once starts unseen.
      document.documentElement.classList.add("js");
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("moves");
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="top wrap">
      <a class="mark" href={sitePath()} aria-label="Poplin, home">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <rect class="back" x="28" y="4" width="32" height="32" rx="8" opacity=".45"></rect>
          <rect x="16" y="16" width="32" height="32" rx="8" fill="#D23C56"></rect>
          <rect x="4" y="28" width="32" height="32" rx="8" fill="#3B66D6"></rect>
        </svg>
        poplin
      </a>
      <nav aria-label="Site">
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
          <li>
            <button class="theme" type="button" data-theme-switch aria-label="Theme: system">
              <Monitor class="system" />
              <Sun class="light" />
              <Moon class="dark" />
            </button>
          </li>
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot wrap">
      <p>poplin {newest?.version}</p>
      <ul>
        <li><a href={`${REPOSITORY_URL}/releases`}>Changelog</a></li>
        <li><a href={`${REPOSITORY_URL}/blob/main/LICENSE.md`}>License</a></li>
      </ul>
    </footer>
    <script>
      const root = document.documentElement;
      // The theme follows the system until one is chosen; the switch goes system, light, dark, and back to system.
      const themeSwitch = document.querySelector<HTMLButtonElement>("[data-theme-switch]");
      const NEXT: Record<string, string> = { system: "light", light: "dark", dark: "system" };
      const name = () => themeSwitch?.setAttribute("aria-label", `Theme: ${root.dataset.theme ?? "system"}`);
      name();
      themeSwitch?.addEventListener("click", () => {
        const next = NEXT[root.dataset.theme ?? "system"] ?? "system";
        if (next === "system") delete root.dataset.theme;
        else root.dataset.theme = next;
        name();
        try {
          if (next === "system") localStorage.removeItem("theme");
          else localStorage.setItem("theme", next);
        } catch {
          // The choice still holds for this page; it is only not remembered.
        }
      });

      for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
        button.addEventListener("click", async () => {
          const said = button.querySelector<HTMLElement>("[data-said]");
          if (!said) return;
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? "");
            said.textContent = "Copied";
          } catch {
            said.textContent = "Failed";
          }
          button.toggleAttribute("data-told", true);
          setTimeout(() => {
            said.textContent = "";
            button.toggleAttribute("data-told", false);
          }, 1600);
        });
      }
    </script>
  </body>
</html>
