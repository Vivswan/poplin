---
import "../styles/site.css";
import { getImage } from "astro:assets";
import { REPOSITORY_URL, sitePath } from "../lib/paths.ts";

interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
const pages = [
  { path: "demo/", label: "Demo" },
  { path: "compare/", label: "Compare" },
];
const fontUrl = sitePath("fonts/barlow-condensed-600.woff2");
const fontFace = `@font-face{font-family:"Barlow Condensed";font-weight:600;font-style:normal;font-display:optional;src:url("${fontUrl}") format("woff2")}`;
const pageUrl = new URL(sitePath(path), Astro.site).href;

// The brand folder at the repository root wins when it exists; the temporary drawings here stand in until then.
const brand = import.meta.glob<ImageMetadata>("../../../brand/{favicon,icon,social}.svg", { eager: true, import: "default" });
const standIn = import.meta.glob<ImageMetadata>("../brand/{favicon,social}.svg", { eager: true, import: "default" });
const favicon = brand["../../../brand/favicon.svg"] ?? standIn["../brand/favicon.svg"];
const icon = brand["../../../brand/icon.svg"] ?? favicon;
const social = brand["../../../brand/social.svg"] ?? standIn["../brand/social.svg"];
if (favicon === undefined || icon === undefined || social === undefined) {
  throw new Error("The favicon or the social image is missing from both brand folders.");
}
const touchIcon = await getImage({ src: icon, width: 180, height: 180, format: "png" });
const card = await getImage({ src: social, width: 1200, height: 630, format: "png" });
const imageUrl = new URL(card.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f2f5fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1a2e" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={favicon.src} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <link rel="preload" as="font" type="font/woff2" href={fontUrl} crossorigin />
    <style is:inline set:html={fontFace} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Poplin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A terminal running poplin ./report and printing a private address." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="top wrap">
      <a class="wordmark" href={sitePath()} aria-label="Poplin, home">poplin</a>
      <nav aria-label="Site">
        <ul>
          {
            pages.map((page) => (
              <li>
                <a href={sitePath(page.path)} aria-current={page.path === path ? "page" : undefined}>
                  {page.label}
                </a>
              </li>
            ))
          }
          <li><a href={sitePath("docs/")}>Docs</a></li>
          <li><a href={REPOSITORY_URL}>GitHub</a></li>
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot wrap">
      <p>
        <span class="wordmark">poplin</span>
        In development, not released.
      </p>
      <ul>
        <li><a href={sitePath("docs/")}>Docs</a></li>
        <li><a href={REPOSITORY_URL}>Source on GitHub</a></li>
        <li><a href={`${REPOSITORY_URL}/blob/main/LICENSE.md`}>Individual and Small Organization License 1.1.0</a></li>
      </ul>
    </footer>
  </body>
</html>
