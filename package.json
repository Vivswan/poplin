{
  "name": "poplin-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "website"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:worker && bun run knip",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc -p . && tsc -p website && bun run --cwd packages/cloudflare typecheck && bun run --cwd packages/demo typecheck",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns 'packages/cloudflare/tests/{worker,storage,database,limits}/**'",
    "test:worker": "bun run --cwd packages/cloudflare test",
    "live": "POPLIN_LIVE=1 bun test ./tests/live/live.test.ts",
    "knip": "knip --treat-config-hints-as-errors",
    "links": "lychee '**/*.md'",
    "deploy": "bun run --cwd packages/cloudflare deploy",
    "preview": "bun run --cwd packages/demo preview",
    "preview:stop": "bun run --cwd packages/demo preview:stop",
    "demo": "bun run --cwd packages/demo demo",
    "demo:build": "bun run --cwd packages/demo build",
    "demo:stop": "bun run --cwd packages/demo demo:stop"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "fast-check": "4.10.2",
    "knip": "6.35.1",
    "typescript": "7.0.2"
  }
}
