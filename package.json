{
  "name": "poplin-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test && bun run knip",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc -p .",
    "test": "bun test --pass-with-no-tests",
    "knip": "knip --treat-config-hints-as-errors"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "knip": "6.35.1",
    "typescript": "7.0.2"
  }
}
