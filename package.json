{
  "name": "poplin-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "website"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:worker && bun run knip",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc -p . && tsc -p website && bun run --cwd packages/worker typecheck",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns 'packages/worker/**'",
    "test:worker": "bun run --cwd packages/worker test",
    "knip": "knip --treat-config-hints-as-errors"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "fast-check": "4.10.2",
    "knip": "6.35.1",
    "typescript": "7.0.2"
  }
}
