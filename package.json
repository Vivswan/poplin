{
  "name": "poplin-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/providers/*",
    "website"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:client && bun run test:worker && bun run knip",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc -p . && tsc -p website && bun run --cwd packages/providers/cloudflare typecheck && bun run --cwd packages/demo typecheck && bun run --cwd packages/dashboard typecheck",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns 'packages/providers/cloudflare/tests/shared/{worker,storage,database,limits,jobs}/**' --path-ignore-patterns 'packages/providers/cloudflare/tests/load/**' --path-ignore-patterns 'packages/dashboard/**'",
    "test:client": "bun run --cwd packages/dashboard test",
    "test:worker": "bun run --cwd packages/providers/cloudflare test",
    "live": "POPLIN_LIVE=1 bun test ./packages/providers/cloudflare/live/live.test.ts",
    "knip": "knip --treat-config-hints-as-errors",
    "links": "lychee '**/*.md'",
    "hooks": "lefthook install",
    "preview": "bun run --cwd packages/demo preview",
    "preview:stop": "bun run --cwd packages/demo preview:stop",
    "demo": "bun run --cwd packages/demo demo",
    "demo:build": "bun run --cwd packages/demo build",
    "demo:stop": "bun run --cwd packages/demo demo:stop"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "fast-check": "4.10.2",
    "hono": "4.13.18",
    "knip": "6.35.1",
    "lefthook": "2.2.2",
    "microdiff": "1.6.0",
    "typescript": "7.0.2"
  }
}
